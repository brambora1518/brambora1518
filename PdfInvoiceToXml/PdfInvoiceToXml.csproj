<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>PdfInvoiceToXml</AssemblyName>
    <RootNamespace>PdfInvoiceToXml</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- If restore fails on any of these exact versions, bump it, e.g.: dotnet add package PdfPig -->
    <PackageReference Include="PdfPig" Version="0.1.8" />
    <!-- Renders a PDF page to a bitmap - used as OCR fallback for scanned/image-only PDFs -->
    <PackageReference Include="PDFtoImage" Version="5.2.1" />
    <!-- OCR engine wrapper (SkiaSharp comes in transitively via PDFtoImage) -->
    <PackageReference Include="Tesseract" Version="5.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Czech (and optionally other) Tesseract trained-data files go here - see tessdata/README.txt -->
    <None Include="tessdata\**\*.traineddata" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
